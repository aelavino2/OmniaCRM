# Скопируйте в .env и при желании поменяйте значения. .env в git не попадает.

# PostgreSQL
POSTGRES_DB=omnia
POSTGRES_USER=omnia
POSTGRES_PASSWORD=change-me
# Порт на хосте. Если 5432 занят локально установленным PostgreSQL — поставьте 5433
POSTGRES_PORT=5432

# RabbitMQ
RABBITMQ_USER=omnia
RABBITMQ_PASSWORD=change-me
# Порт AMQP для сервисов
RABBITMQ_PORT=5672
# Порт веб-интерфейса: http://localhost:15672
RABBITMQ_MANAGEMENT_PORT=15672
